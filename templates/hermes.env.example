# Copy only into /srv/agent-lab/data/.env inside the dedicated VM.
# These are placeholders. Never place real credentials in this repository.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama-local
# Generated by setup --gateway-only. Do not supply a real key here.
API_SERVER_KEY=
# Native Telegram stays disabled; the custom bot has its own private .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
GATEWAY_ALLOWED_USERS=
TELEGRAM_GUEST_MODE=false
TELEGRAM_GROUP_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_CHATS=
